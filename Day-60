// Write a program to take an integer array arr and an integer k as inputs. The task is to find the maximum element in each subarray of size k moving from left to right. Print the maximum elements for each window separated by spaces as output.
#include <stdio.h>

void printSlidingWindowMax(int arr[], int n, int k) {
    int dq[n]; // Array to store indices of useful elements
    int front = 0, rear = -1;

    for (int i = 0; i < n; i++) {
        // 1. Remove indices that are out of the current window (i - k)
        if (front <= rear && dq[front] <= i - k) {
            front++;
        }

        // 2. Remove indices from the back whose elements are smaller than or equal to arr[i]
        while (front <= rear && arr[dq[rear]] <= arr[i]) {
            rear--;
        }

        // 3. Add the current element's index to the back of the deque
        dq[++rear] = i;

        // 4. Once the first window of size k is reached, print its maximum (at dq[front])
        if (i >= k - 1) {
            if (i < n - 1) {
                printf("%d ", arr[dq[front]]);
            } else {
                printf("%d\n", arr[dq[front]]);
            }
        }
    }
}

int main() {
    int n, k;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter k: ");
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("Invalid window size k.\n");
        return 0;
    }

    printSlidingWindowMax(arr, n, k);

    return 0;
}
