// Take two filenames from the user – a source file and a destination file. Copy all the content from the source file to the destination file using fgetc() and fputc().
#include <stdio.h>

int main() {
    FILE *srcFile, *destFile;
    char srcName, destName;
    int ch;

    printf("Enter source filename: ");
    if (scanf("%99s", srcName) != 1) {
        return 1;
    }

    printf("Enter destination filename: ");
    if (scanf("%99s", destName) != 1) {
        return 1;
    }

    // Open source file in read mode ("r")
    srcFile = fopen(srcName, "r");
    if (srcFile == NULL) {
        printf("Error: Could not open source file %s.\n", srcName);
        return 1;
    }

    // Open destination file in write mode ("w")
    destFile = fopen(destName, "w");
    if (destFile == NULL) {
        printf("Error: Could not create destination file %s.\n", destName);
        fclose(srcFile);
        return 1;
    }

    // Copy character by character until EOF
    while ((ch = fgetc(srcFile)) != EOF) {
        fputc(ch, destFile);
    }

    // Close both files
    fclose(srcFile);
    fclose(destFile);

    printf("File copied successfully from %s to %s.\n", srcName, destName);

    return 0;
}
