// Write a program to find the product of odd digits of a number.
#include <stdio.h>

int main() {
    long long num, temp;
    long long product = 1;
    int digit, hasOdd = 0;

    printf("Enter an integer: ");
    scanf("%lld", &num);

    temp = (num < 0) ? -num : num;

    while (temp > 0) {
        digit = temp % 10;
        if (digit % 2 != 0) {
            product *= digit;
            hasOdd = 1;
        }
        temp /= 10;
    }

    if (hasOdd) {
        printf("Product of odd digits in %lld = %lld\n", num, product);
    } else {
        printf("No odd digits found in %lld (Product = 0).\n", num);
    }

    return 0;
}
// Write a program to find the 1’s complement of a binary number and print it.
 #include <stdio.h>

int main() {
    char binary[65];

    printf("Enter a binary number: ");
    scanf("%64s", binary);

    for (int i = 0; binary[i] != '\0'; i++) {
        if (binary[i] == '0') {
            binary[i] = '1';
        } else if (binary[i] == '1') {
            binary[i] = '0';
        } else {
            printf("Error! Invalid binary digit '%c'.\n", binary[i]);
            return 0;
        }
    }

    printf("1's complement = %s\n", binary);

    return 0;
}
