// Insert an element in an array at a given position.
#include <stdio.h>

int main() {
    int n, key, pos;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    // Allocate size n + 1 to accommodate the new element
    int arr[n + 1];

    // Read elements into the array
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter the element to insert: ");
    scanf("%d", &key);

    printf("Enter the position (1 to %d): ", n + 1);
    scanf("%d", &pos);

    // Validate the position
    if (pos < 1 || pos > n + 1) {
        printf("Invalid position! Please enter a position between 1 and %d.\n", n + 1);
        return 1;
    }

    // Shift elements one position to the right from the end down to pos - 1
    for (int i = n - 1; i >= pos - 1; i--) {
        arr[i + 1] = arr[i];
    }

    // Insert the new element at index pos - 1
    arr[pos - 1] = key;
    n++; // Update array size

    // Print the updated array
    printf("Array after insertion:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    printf("\n");
    return 0;
}
// Delete an element from an array.
#include <stdio.h>

int main() {
    int n, pos;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Array cannot be empty.\n");
        return 1;
    }

    int arr[n];

    // Read elements into the array
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter the position to delete (1 to %d): ", n);
    scanf("%d", &pos);

    // Validate the position
    if (pos < 1 || pos > n) {
        printf("Invalid position! Please enter a position between 1 and %d.\n", n);
        return 1;
    }

    // Shift elements one position to the left starting from pos - 1
    for (int i = pos - 1; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }

    n--; // Reduce logical array size

    // Print the updated array
    printf("Array after deletion:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    printf("\n");
    return 0;
}
