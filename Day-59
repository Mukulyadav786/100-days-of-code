// Write a program to take an integer array arr and an integer k as inputs. Print the maximum sum of all the subarrays of size k.
#include <stdio.h>

long long maxSubarraySumOfSizeK(int arr[], int n, int k) {
    // Calculate the sum of the first window of size k
    long long windowSum = 0;
    for (int i = 0; i < k; i++) {
        windowSum += arr[i];
    }

    long long maxSum = windowSum;

    // Slide the window from index k to n - 1
    for (int i = k; i < n; i++) {
        windowSum += arr[i] - arr[i - k]; // Add next element, remove first element of previous window
        if (windowSum > maxSum) {
            maxSum = windowSum;
        }
    }

    return maxSum;
}

int main() {
    int n, k;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter k: ");
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("Invalid window size k.\n");
        return 0;
    }

    long long result = maxSubarraySumOfSizeK(arr, n, k);
    printf("%lld\n", result);

    return 0;
}
