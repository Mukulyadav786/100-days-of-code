// Write a program to find the LCM of two numbers.
#include <stdio.h>
#include <stdlib.h>

int main() {
    int num1, num2, a, b, temp;
    long long lcm;

    printf("Enter two integers: ");
    scanf("%d %d", &num1, &num2);

    if (num1 == 0 || num2 == 0) {
        printf("LCM of %d and %d = 0\n", num1, num2);
        return 0;
    }

    a = abs(num1);
    b = abs(num2);

    // Find GCD using the Euclidean algorithm
    int x = a, y = b;
    while (y != 0) {
        temp = y;
        y = x % y;
        x = temp;
    }

    // Divide before multiplying to prevent integer overflow
    lcm = ((long long)a / x) * b;

    printf("LCM of %d and %d = %lld\n", num1, num2, lcm);

    return 0;
}
