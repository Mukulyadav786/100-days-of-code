// Write a Program to take an integer array nums. Print an array answer such that answer[i] is equal to the product of all the elements of nums except nums[i]. The product of any prefix or suffix of nums is guaranteed to fit in a 32-bit integer.
#include <stdio.h>

void productExceptSelf(int nums[], int answer[], int n) {
    // Pass 1: Store prefix products (product of all elements to the left of i)
    int prefix = 1;
    for (int i = 0; i < n; i++) {
        answer[i] = prefix;
        prefix *= nums[i];
    }

    // Pass 2: Multiply by suffix products (product of all elements to the right of i)
    int suffix = 1;
    for (int i = n - 1; i >= 0; i--) {
        answer[i] *= suffix;
        suffix *= nums[i];
    }
}

int main() {
    int n;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int nums[n];
    int answer[n];

    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

    productExceptSelf(nums, answer, n);

    for (int i = 0; i < n; i++) {
        if (i < n - 1) {
            printf("%d, ", answer[i]);
        } else {
            printf("%d\n", answer[i]);
        }
    }

    return 0;
}
