// Change the date format from dd/04/yyyy to dd-Apr-yyyy.
#include <stdio.h>

int main() {
    char inputDate[] = "09/04/2026";
    char outputDate[15];
    int day, month, year;

    const char *months[] = {
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    };

    // Parse dd/mm/yyyy into integers
    if (sscanf(inputDate, "%d/%d/%d", &day, &month, &year) == 3) {
        if (month >= 1 && month <= 12) {
            // Format into dd-MMM-yyyy
            sprintf(outputDate, "%02d-%s-%d", day, months[month - 1], year);
            printf("Output: %s\n", outputDate);
        }
    }

    return 0;
}
// Print all sub-strings of a string.
#include <stdio.h>
#include <string.h>

int main() {
    char str[] = "code";
    int n = strlen(str);

    // Outer loop picks the starting index
    for (int i = 0; i < n; i++) {
        // Inner loop picks the length of the substring
        for (int len = 1; len <= n - i; len++) {
            // Print 'len' characters starting from address &str[i]
            printf("%.*s\n", len, str + i);
        }
    }

    return 0;
}
