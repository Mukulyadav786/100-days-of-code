// Write a program to print all factors of a given number.
#include <stdio.h>

int main() {
    int num, i;

    printf("Enter a positive integer: ");
    scanf("%d", &num);

    if (num <= 0) {
        printf("Please enter a positive integer greater than 0.\n");
        return 0;
    }

    printf("Factors of %d are: ", num);

    // First pass: print smaller factors from 1 up to sqrt(num)
    for (i = 1; i * i <= num; i++) {
        if (num % i == 0) {
            printf("%d ", i);
        }
    }

    // Second pass: print paired larger factors in ascending order
    for (i = i - 1; i >= 1; i--) {
        if (num % i == 0 && i != num / i) {
            printf("%d ", num / i);
        }
    }

    printf("\n");

    return 0;
}
// Write a program to find the HCF (GCD) of two numbers.
#include <stdio.h>
#include <stdlib.h>

int main() {
    int num1, num2, a, b, temp;

    printf("Enter two integers: ");
    scanf("%d %d", &num1, &num2);

    if (num1 == 0 && num2 == 0) {
        printf("HCF of 0 and 0 is undefined.\n");
        return 0;
    }

    a = abs(num1);
    b = abs(num2);

    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }

    printf("HCF (GCD) of %d and %d = %d\n", num1, num2, a);

    return 0;
}
