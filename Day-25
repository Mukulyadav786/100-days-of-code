/* Write a program to print the following pattern:
5
45
345
2345
12345
*/
#include <stdio.h>

int main() {
    int rows = 5;

    for (int i = rows; i >= 1; i--) {
        for (int j = i; j <= rows; j++) {
            printf("%d", j);
        }
        printf("\n");
    }

    return 0;
}
/* Write a program to print the following pattern:
*****
 ****
  ***
   **
    *
*/
#include <stdio.h>

int main() {
    int rows = 5;

    for (int i = 1; i <= rows; i++) {
        // Print leading spaces
        for (int s = 1; s < i; s++) {
            printf(" ");
        }
        // Print stars
        for (int j = i; j <= rows; j++) {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}

