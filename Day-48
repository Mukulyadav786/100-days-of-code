// Check if one string is a rotation of another.
#include <stdio.h>

int main() {
    char str1[100], str2[100];
    int len1 = 0, len2 = 0;

    printf("Enter first string: ");
    scanf(" %99[^\n]", str1);

    printf("Enter second string: ");
    scanf(" %99[^\n]", str2);

    // Calculate lengths of both strings
    while (str1[len1] != '\0') {
        len1++;
    }
    while (str2[len2] != '\0') {
        len2++;
    }

    // Rotations must have the exact same length
    if (len1 != len2) {
        printf("'%s' is NOT a rotation of '%s'.\n", str2, str1);
        return 0;
    }

    // Handle empty strings
    if (len1 == 0) {
        printf("'%s' is a ROTATION of '%s'.\n", str2, str1);
        return 0;
    }

    // Try every possible starting shift in str1 and wrap around with modulo
    int is_rotation = 0;
    for (int shift = 0; shift < len1; shift++) {
        int match = 1;
        for (int i = 0; i < len1; i++) {
            if (str1[(shift + i) % len1] != str2[i]) {
                match = 0;
                break;
            }
        }
        if (match) {
            is_rotation = 1;
            break;
        }
    }

    if (is_rotation) {
        printf("'%s' is a ROTATION of '%s'.\n", str2, str1);
    } else {
        printf("'%s' is NOT a rotation of '%s'.\n", str2, str1);
    }

    return 0;
}
// Reverse each word in a sentence without changing the word order.
#include <stdio.h>

// Helper function to reverse characters between indices start and end
void reverseWord(char str[], int start, int end) {
    while (start < end) {
        char temp = str[start];
        str[start] = str[end];
        str[end] = temp;
        start++;
        end--;
    }
}

int main() {
    char str[200];
    int start = 0;

    printf("Enter a sentence: ");
    scanf(" %199[^\n]", str);

    // Traverse the sentence and reverse each word individually
    for (int i = 0; ; i++) {
        if (str[i] == ' ' || str[i] == '\0') {
            reverseWord(str, start, i - 1);
            start = i + 1;
        }
        if (str[i] == '\0') {
            break;
        }
    }

    printf("Sentence with reversed words: %s\n", str);

    return 0;
}
