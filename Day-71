// Write a C program that creates a text file named info.txt in write mode. The program should take the user’s name and age as input, and write them to the file using fprintf(). After writing, display a message confirming that the data was successfully saved.
#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char name[100];
    int age;

    // Open info.txt in write mode ("w")
    fp = fopen("info.txt", "w");
    if (fp == NULL) {
        printf("Error: Could not create info.txt.\n");
        return 1;
    }

    // Take user's name (supports spaces) and age as input
    printf("Enter your name: ");
    if (fgets(name, sizeof(name), stdin) != NULL) {
        // Remove trailing newline added by fgets
        name[strcspn(name, "\n")] = '\0';
    }

    printf("Enter your age: ");
    if (scanf("%d", &age) != 1) {
        printf("Invalid age input.\n");
        fclose(fp);
        return 1;
    }

    // Write name and age to the file using fprintf()
    fprintf(fp, "Name: %s\nAge: %d\n", name, age);

    // Close the file to flush data to disk
    fclose(fp);

    printf("Data successfully saved to info.txt.\n");

    return 0;
}
