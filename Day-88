// Print all enum names and integer values using a loop.
#include <stdio.h>

enum Days
{
    SUNDAY = 1,
    MONDAY,
    TUESDAY,
    WEDNESDAY,
    THURSDAY,
    FRIDAY,
    SATURDAY
};

int main()
{
    char *names[] = {
        "SUNDAY",
        "MONDAY",
        "TUESDAY",
        "WEDNESDAY",
        "THURSDAY",
        "FRIDAY",
        "SATURDAY"
    };

    int i;

    printf("Enum Names and Integer Values:\n\n");

    for (i = 0; i < 7; i++)
    {
        printf("%s = %d\n", names[i], i + 1);
    }

    return 0;
}
