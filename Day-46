// Remove all vowels from a string.
#include <stdio.h>

int main() {
    char str[100];
    int j = 0;

    printf("Enter a string: ");
    scanf(" %99[^\n]", str);

    // Copy only non-vowel characters to the front of the string
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        if (ch != 'a' && ch != 'e' && ch != 'i' && ch != 'o' && ch != 'u' &&
            ch != 'A' && ch != 'E' && ch != 'I' && ch != 'O' && ch != 'U') {
            str[j] = str[i];
            j++;
        }
    }

    // Terminate the modified string
    str[j] = '\0';

    printf("String without vowels: %s\n", str);

    return 0;
}
// Find the first repeating lowercase alphabet in a string.
#include <stdio.h>

int main() {
    char str[100];
    int seen[26] = {0}; // Tracks seen lowercase letters 'a' through 'z'
    char first_repeating = '\0';

    printf("Enter a string: ");
    scanf(" %99[^\n]", str);

    // Scan the string from left to right
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] >= 'a' && str[i] <= 'z') {
            int index = str[i] - 'a';
            if (seen[index] == 1) {
                first_repeating = str[i];
                break;
            }
            seen[index] = 1;
        }
    }

    if (first_repeating != '\0') {
        printf("First repeating lowercase alphabet: '%c'\n", first_repeating);
    } else {
        printf("No repeating lowercase alphabet found.\n");
    }

    return 0;
}
