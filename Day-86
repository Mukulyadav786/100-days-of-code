// Use enum to represent menu choices (ADD, SUBTRACT, MULTIPLY) and perform operations using switch.
#include <stdio.h>

enum Operations
{
    ADD = 1,
    SUBTRACT,
    MULTIPLY
};

int main()
{
    int choice;
    float num1, num2;

    printf("----- MENU -----\n");
    printf("1. ADD\n");
    printf("2. SUBTRACT\n");
    printf("3. MULTIPLY\n");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    printf("Enter two numbers: ");
    scanf("%f %f", &num1, &num2);

    switch (choice)
    {
        case ADD:
            printf("Addition = %.2f", num1 + num2);
            break;

        case SUBTRACT:
            printf("Subtraction = %.2f", num1 - num2);
            break;

        case MULTIPLY:
            printf("Multiplication = %.2f", num1 * num2);
            break;

        default:
            printf("Invalid choice!");
    }

    return 0;
}
